{
  "name": "conference-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "program": "node scripts/build-program.ts",
    "program:check": "node scripts/check-program.ts",
    "program:publish": "node scripts/publish-program.ts",
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy -c dist/conference_planner/wrangler.json"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "hono": "^4.12.31",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "aws4fetch": "^1.0.20",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0",
    "zod": "^4.4.3"
  }
}
