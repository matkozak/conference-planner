{
  "name": "aaic2026",
  "private": true,
  "type": "module",
  "scripts": {
    "program": "node scripts/build-program.ts",
    "dev": "vite dev",
    "build": "npm run program && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy": "npm run build && wrangler deploy -c dist/aaic2026/wrangler.json"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "hono": "^4.12.28"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.2",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.108.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260706.1": true
  }
}
